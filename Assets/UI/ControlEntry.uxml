<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="Entry" data-source-type="UnityEngine.InputSystem.InputAction, Unity.InputSystem" class="row" style="flex-grow: 1; width: auto; flex-direction: row; background-color: rgb(231, 231, 231); position: relative; right: auto; font-size: 14px; align-items: center; height: 70%; margin-bottom: 0; margin-top: 30px; max-height: 70%; min-height: 70px;">
        <ui:VisualElement name="ControlName" style="flex-grow: 1; width: auto; height: auto;">
            <ui:Label text="CONTROL NAME" name="ControlNameLabel" style="height: auto; font-size: 50px; -unity-font-style: bold; flex-grow: 1; flex-direction: row; flex-shrink: 0; flex-basis: 0%; -unity-font-definition: url(&quot;project://database/Assets/Sprites/pixelart.ttf?fileID=12800000&amp;guid=5e71521f5a399474582f5c5e8fc273f3&amp;type=3#pixelart&quot;);">
                <Bindings>
                    <ui:DataBinding property="text" data-source-path="m_Name" binding-mode="ToTarget" data-source=""/>
                </Bindings>
            </ui:Label>
        </ui:VisualElement>
        <ui:VisualElement name="Keyboard" style="flex-grow: 1; align-items: flex-start; height: auto;">
            <ui:Label text="Label" name="KeyboardLabel" usage-hints="None" style="height: auto; width: auto; font-size: 50px; -unity-font-style: bold; flex-basis: 0%; -unity-font-definition: url(&quot;project://database/Assets/Sprites/pixelart.ttf?fileID=12800000&amp;guid=5e71521f5a399474582f5c5e8fc273f3&amp;type=3#pixelart&quot;);">
                <Bindings>
                    <CustomInputDisplayBinding property="text"/>
                </Bindings>
            </ui:Label>
        </ui:VisualElement>
        <ui:VisualElement name="Gamepad" style="flex-grow: 1; height: auto; align-items: stretch;">
            <ui:Label text="Label" name="GamepadLabel" style="height: auto; width: auto; font-size: 50px; -unity-font-style: bold; flex-grow: 1; flex-basis: 0%; -unity-font-definition: url(&quot;project://database/Assets/Sprites/pixelart.ttf?fileID=12800000&amp;guid=5e71521f5a399474582f5c5e8fc273f3&amp;type=3#pixelart&quot;);">
                <Bindings>
                    <CustomInputDisplayBinding property="text" device="Gamepad"/>
                </Bindings>
            </ui:Label>
        </ui:VisualElement>
        <ui:Button text="Rebind" name="RemapButton" style="flex-direction: row; align-items: center; margin-right: 100px; font-size: 40px;"/>
    </ui:VisualElement>
</ui:UXML>
